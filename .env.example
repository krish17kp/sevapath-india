# SevaPath environment variable names only.
# Never place real credentials in this file. Copy to .env.local and fill in
# locally; .env* files are gitignored.

# ---------------------------------------------------------------------------
# Retrieval adapter selection
# ---------------------------------------------------------------------------
# "local"  -> deterministic file-backed retrieval over rag-corpus/ingest (default)
# "vertex" -> Google Vertex AI RAG Engine via the Python ADK sidecar
SEVAPATH_RETRIEVAL_ADAPTER=

# ---------------------------------------------------------------------------
# Optional model-assisted extraction and explanation (Anthropic)
# When unset, SevaPath uses the deterministic no-key extraction fallback.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
SEVAPATH_MODEL=

# ---------------------------------------------------------------------------
# Google Cloud / Vertex AI RAG Engine (cloud adapter only)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_APPLICATION_CREDENTIALS=
SEVAPATH_RAG_CORPUS_NAME=
SEVAPATH_RAG_CORPUS_RESOURCE=
# Base URL of the Python retrieval sidecar, with no path. The adapter appends
# /search and /health itself, so do not include them here.
SEVAPATH_VERTEX_RETRIEVAL_URL=
